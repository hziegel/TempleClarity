# Settings for the CMS. Copy this file to .env (same folder) and fill it in.
#
# You can leave DATABASE_URL out: if ../backend/.env exists, the CMS reads the same
# DATABASE_URL and DATABASE_SSL from there, so you only keep one copy of the password.

# The Supabase *Session pooler* connection string (the same one the backend uses).
# DATABASE_URL=postgresql://postgres.xxxxxxxx:YOUR-PASSWORD@aws-0-xx-xxxx-x.pooler.supabase.com:5432/postgres
# DATABASE_SSL=1

# Optional. A random key is created for you in cms/.secret_key on first run.
# CMS_SECRET_KEY=
