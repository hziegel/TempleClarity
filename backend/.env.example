# Copy to .env and fill in. Never commit the real .env.
PORT=3000

# Postgres connection string (Supabase: Project Settings > Database > Connection string,
# or your own managed Postgres).
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres
# Set to 1 when your database requires SSL (Supabase and most managed Postgres do).
DATABASE_SSL=0

# Supabase: Project Settings > API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
# Server only. Gives full admin access, so it must never reach the browser or the repo.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated list of sites allowed to call the API from a browser.
ALLOWED_ORIGINS=https://templeclarity.com,https://www.templeclarity.com

# Set to 1 when running behind a proxy or CDN that sets X-Forwarded-For (for rate limits).
TRUST_PROXY=0
# Set to 1 to also serve index.html and the SEO files from the folder above this one.
SERVE_STATIC=0

# How much the recommender shuffles activities (see src/recommender.js).
# 1 = scores act as weights (default), 0.5 = stays closer to the score order,
# 0 = no shuffling at all (strictly highest score first).
RECOMMENDER_TEMPERATURE=1
